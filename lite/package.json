{
	"name": "kanjisense",
	"type": "module",
	"scripts": {
		"dev:hono": "bun run --hot src/index.tsx",
		"dev:css": "bun x @tailwindcss/cli -i ./src/styles.css -o ./public/static/style.css --watch",
		"dev": "bun x concurrently \"bun run dev:hono\" \"bun run dev:css\"",
		"build": "bun x @tailwindcss/cli -i ./src/styles.css -o ./public/static/style.css --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings"
	},
	"dependencies": {
		"@tailwindcss/cli": "^4.2.0",
		"hono": "^4.12.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.2.0",
		"wrangler": "^4.67.0"
	}
}
