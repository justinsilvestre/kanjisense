{
	"name": "kanjisense",
	"type": "module",
	"scripts": {
		"dev": "bunx concurrently \"bun run dev:wrangler\" \"bun run dev:css\"",
		"dev:wrangler": "bunx wrangler dev",
		"dev:css": "bunx @tailwindcss/cli -i ./src/styles.css -o ./public/static/style.css --watch",
		"studio": "bunx drizzle-kit studio --config=drizzle.studio.config.ts",
		"build": "bunx @tailwindcss/cli -i ./src/styles.css -o ./public/static/style.css --minify",
		"deploy": "wrangler deploy --minify",
		"db:generate": "bunx drizzle-kit generate",
		"migrate:local": "bunx wrangler d1 migrations apply kanjisense-db --local",
		"migrate:production": "bunx wrangler d1 migrations apply kanjisense-db --production",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings"
	},
	"dependencies": {
		"@libsql/client": "^0.17.0",
		"@tailwindcss/cli": "^4.2.0",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.3",
		"@types/bun": "^1.3.9",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "^0.31.9",
		"tailwindcss": "^4.2.0",
		"wrangler": "^4.67.0"
	}
}
